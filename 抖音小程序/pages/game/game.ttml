<view class="app">

  <canvas
    id="game"
    canvas-id="game"
    type="2d"
    class="cv"
    disable-scroll="true"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
  ></canvas>

  <!-- 开始页 -->
  <view class="screen {{phase === 'ready' ? '' : 'hide'}}">
    <view class="title">神也过不了</view>
    <view class="title title2">第二关</view>
    <view class="sub">数字门 · 穿过数字门，把数字滚到最大</view>

    <!-- 排行榜 -->
    <view class="rank" bindtap="onRankTap">
      <view class="rank-head">
        <text class="rank-title">排行榜</text>
        <text class="rank-tip">{{rankTip}}</text>
      </view>

      <view class="rank-row" tt:for="{{rankList}}" tt:key="key">
        <text class="rank-no {{index < 3 ? 'rank-no-top' : ''}}">{{index + 1}}</text>
        <view class="rank-avatar">{{item.initial}}</view>
        <text class="rank-name">{{item.name}}</text>
        <text class="rank-num">{{item.numText}}</text>
        <text class="rank-stage">{{item.stage}} 关</text>
      </view>

      <view class="rank-empty" tt:if="{{rankList.length === 0}}">还没有成绩，先玩一局上榜</view>
      <view class="rank-foot" tt:if="{{rankList.length > 0}}">最高数字 · 关卡　|　好友榜需小游戏版本</view>
    </view>

    <view class="rules">
      <view class="rule">点屏幕 <text class="hl">左 / 中 / 右</text> 切换跑道</view>
      <view class="rule">穿过数字门 = 执行门上的 <text class="hl">+ × − ÷</text></view>
      <view class="rule">数字 <text class="hl">≥ 紫色 BOSS 门</text> 才能继续冲关</view>
    </view>

    <view class="btn" bindtap="onStartTap" hover-class="btn-hover">开始挑战</view>
    <view class="best">最高纪录 数字 <text class="hl">{{bestNum}}</text></view>
  </view>

  <!-- 结算页 -->
  <view class="screen {{phase === 'over' ? '' : 'hide'}}">
    <view class="over-title">{{overTitle}}</view>
    <view class="stats">
      <view class="stat">
        <view class="k">最大数字</view>
        <view class="v">{{sNum}}</view>
      </view>
      <view class="stat">
        <view class="k">通过关卡</view>
        <view class="v">{{sStage}}</view>
      </view>
      <view class="stat">
        <view class="k">最高纪录</view>
        <view class="v">{{sBest}}</view>
      </view>
    </view>
    <view class="over-rank" tt:if="{{rankPos}}">本次成绩 榜上第 <text class="hl">{{rankPos}}</text> 名</view>
    <view class="btn" bindtap="onStartTap" hover-class="btn-hover">再来一次</view>
  </view>

  <view class="snd {{phase === 'play' ? '' : 'snd-dim'}}" bindtap="toggleSound">
    {{muted ? '🔇' : '🔊'}}
  </view>

</view>
