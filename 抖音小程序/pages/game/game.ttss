.app {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #05030c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-user-select: none;
  user-select: none;
}

.cv {
  position: absolute;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  display: block;
}

/* ---------- 遮罩页 ---------- */
.screen {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 48rpx;
  background: rgba(7, 4, 18, 0.78);
  transition: opacity 0.25s ease;
  z-index: 5;
}

.screen.hide {
  opacity: 0;
  pointer-events: none;
}

.title {
  font-size: 104rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  line-height: 1.1;
  color: #5fe3ff;
  text-shadow: 0 0 40rpx rgba(90, 225, 255, 0.55);
}

.title2 {
  margin-top: 4rpx;
  font-size: 104rpx;
  color: #c46bff;
  text-shadow: 0 0 40rpx rgba(196, 107, 255, 0.6);
}

.sub {
  margin-top: 18rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: #8fa8cc;
}

.rules {
  margin-top: 48rpx;
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
}

.rule {
  margin-bottom: 18rpx;
  padding: 22rpx 26rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #a9c0dd;
  border-radius: 20rpx;
  background: rgba(120, 190, 255, 0.06);
  border: 1rpx solid rgba(120, 190, 255, 0.13);
}

.hl {
  color: #5fe3ff;
  font-weight: 700;
}

.btn {
  margin-top: 44rpx;
  padding: 30rpx 96rpx;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: #04121c;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #a8f4ff, #33d3ff 55%, #1aa6e6);
  box-shadow: 0 14rpx 46rpx rgba(50, 200, 255, 0.42);
}

.btn-hover {
  transform: scale(0.96);
  opacity: 0.92;
}

.best {
  margin-top: 26rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #7f96b8;
}

/* ---------- 结算 ---------- */
.over-title {
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #ff9ab6;
  text-shadow: 0 0 40rpx rgba(255, 80, 130, 0.55);
}

.stats {
  margin-top: 40rpx;
  width: 100%;
  max-width: 620rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.stat {
  flex: 1;
  margin: 0 8rpx;
  padding: 24rpx 8rpx;
  border-radius: 22rpx;
  background: rgba(120, 190, 255, 0.07);
  border: 1rpx solid rgba(120, 190, 255, 0.16);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.k {
  font-size: 20rpx;
  color: #8fa8cc;
  letter-spacing: 2rpx;
}

.v {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 900;
  color: #eafcff;
}

/* ---------- 声音按钮 ---------- */
.snd {
  position: absolute;
  right: 24rpx;
  bottom: calc(24rpx + constant(safe-area-inset-bottom));
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 50%;
  color: #bfe6ff;
  background: rgba(20, 12, 44, 0.62);
  border: 1rpx solid rgba(130, 200, 255, 0.22);
  z-index: 6;
}

.snd-dim {
  opacity: 0.35;
}


